{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "panta-rei-fe.vercel.app" }],
      "destination": "https://www.pantareinastani.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "(www\\.)?pantareinastani\\.com" }],
      "destination": "/robots-allow.txt"
    },
    {
      "source": "/robots.txt",
      "missing": [{ "type": "host", "value": "(www\\.)?pantareinastani\\.com" }],
      "destination": "/robots-block.txt"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(favicon.*|apple-touch-icon\\.png|icon-.*\\.png|og-image\\.jpg|site\\.webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "(www\\.)?pantareinastani\\.com" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noimageindex" }]
    }
  ]
}
