# Public site settings (not secret — committed on purpose)

# The live address of the site, without a trailing slash.
# Used for the canonical URL, social previews, sitemap.xml, robots.txt and structured data.
# Change this when you connect your own domain (e.g. https://pantarei.mk) and redeploy.
VITE_SITE_URL=https://panta-rei-fe.vercel.app

# Colour theme: "metallic" (black / rose-gold from the logo) or empty for the original cream / red look
VITE_THEME=metallic
